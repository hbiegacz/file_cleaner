{
  "TARGET_PERMISSIONS": "rw-r--r--",
  "SUSPICIOUS_CHARS": [
    " ",
    "'",
    "\"",
    ",",
    ";",
    "*",
    "?",
    "$",
    "#",
    "&",
    "|",
    "\\"
  ],
  "SUSPICIOUS_CHAR_SUBSTITUTE": "_",
  "TEMP_FILE_PATTERNS": [
    "*.tmp",
    "*~",
    "*.bak"
  ],
  "DRY_RUN": true,
  "KEEP_DUPLICATE_STRATEGY": "oldest",
  "IGNORED_DIRS": [
    ".git",
    "__pycache__",
    ".DS_Store",
    "node_modules",
    ".idea"
  ]
}